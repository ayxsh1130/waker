# Copy to .env. No paid service or application login is required for RULE_BASED.
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://autopilot:change_me_local_only@postgres:5432/autopilot
REDIS_URL=redis://redis:6379/0
BROKER_PROBE_URL=redis://broker-proxy:16379/0
APP_ENVIRONMENT=development
APP_AUTH_ENABLED=false
ADMIN_TOKEN=
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTO_INVESTIGATE=true
FAULTS_ENABLED=true
REMEDIATION_MODE=dry_run
REMEDIATION_MIN_CONFIDENCE=0.75
REMEDIATION_COOLDOWN_SECONDS=60
OBSERVATION_SECONDS=20
WORKER_OFFLINE_SECONDS=25
BACKLOG_THRESHOLD=20
FAILURE_RATE_THRESHOLD=0.5
LATENCY_THRESHOLD_SECONDS=8
ALERT_MIN_COMPLETIONS=5
DETECTION_WINDOW_SECONDS=120
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Compatible endpoint includes /v1; the client appends /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
# Leave blank prices out of .env entirely; to estimate cost, uncomment numeric rates.
# LLM_INPUT_COST_PER_MILLION=0.00
# LLM_OUTPUT_COST_PER_MILLION=0.00
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_REINVESTIGATIONS=2
AGENT_MAX_CONTEXT_CHARS=32000
AGENT_PROMPT_VERSION=v1
WORKFLOW_VERSION=v1
TOOL_TIMEOUT_SECONDS=8
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_SERVICE_URL=http://retrieval:8081
RAG_MAX_RESULTS=4
GITHUB_TOKEN=
GITHUB_REPOSITORY=
LOCAL_REPOSITORY_PATH=/source/workers
SOFTWARE_REVISION=unversioned
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_local
# The internal service token is generated into a Docker volume automatically.
